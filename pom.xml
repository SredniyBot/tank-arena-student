<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>student</groupId>
    <artifactId>colony</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>Моя колония</name>

    <properties>
        <!-- Версию SDK меняет преподаватель вместе с папкой sdk-repo; самопроверка скажет, если она устарела. -->
        <colony.sdk.version>0.2.0</colony.sdk.version>

        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
    </properties>

    <repositories>
        <!-- SDK лежит в папке sdk-repo этого репозитория; остальные библиотеки Maven скачивает из интернета. -->
        <repository>
            <id>colony</id>
            <url>file://${maven.multiModuleProjectDirectory}/sdk-repo</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.github.sredniybot.colony</groupId>
            <artifactId>colony-sdk</artifactId>
            <version>${colony.sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <!-- браузер в тестах не открываем -->
                    <systemPropertyVariables>
                        <colony.browser>false</colony.browser>
                        <java.awt.headless>true</java.awt.headless>
                    </systemPropertyVariables>
                    <!--
                        Уровни ДЗ (LevelsTest) красные, пока уровень не сделан, поэтому сборку не роняют: в IntelliJ они
                        запускаются ▶, на GitHub — отдельным шагом проверки.
                    -->
                    <excludes>
                        <exclude>**/LevelsTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
            </plugin>
        </plugins>
    </build>
</project>
